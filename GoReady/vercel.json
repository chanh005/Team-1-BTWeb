{
  "redirects": [
    {
      "source": "/news",
      "destination": "/#/cong-dong",
      "permanent": true
    },
    {
      "source": "/news/:path*",
      "destination": "/#/cong-dong",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
