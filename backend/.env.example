# Server
NODE_ENV=development
PORT=4000

# CORS - must match the frontend origin
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL connection string used by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/travel_platform?schema=public"

# JWT access token (short-lived, sent in the response body / Authorization header)
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m

# JWT refresh token (long-lived, stored server-side hashed, sent as httpOnly cookie)
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Name of the httpOnly cookie used to carry the refresh token
REFRESH_COOKIE_NAME=refreshToken
