# Chuỗi kết nối Postgres (Neon): Dashboard Neon -> Connection Details -> copy "Connection string".
# Dạng: postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# Bỏ trống => API /api/tours trả 503 và front end tự dùng Google Sheets / CSV mẫu.
DATABASE_URL=

# Cổng chạy API (front end dev proxy /api -> cổng này, xem GoReady/vite.config.ts)
PORT=4000

# Nguồn dữ liệu tour khi seed vào database (link Google Sheets chia sẻ "bất kỳ ai có link").
# Bỏ trống => dùng GoReady/public/data/suggested-tours.csv
SUGGESTED_TOURS_URL=
